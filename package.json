{
  "name": "webpack-starter",
  "version": "1.0.0",
  "description": "A light foundation for your next frontend project based on webpack.",
  "scripts": {
    "build": "webpack --config webpack/webpack.config.prod.js  --colors",
    "build-staging": "webpack --config webpack/webpack.config.staging.js  --colors",
    "dev": "webpack-dev-server --config webpack/webpack.config.dev.js",
    "prepare": "husky"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wbkd/webpack-starter.git"
  },
  "keywords": [
    "webpack",
    "startkit",
    "frontend",
    "es6",
    "javascript",
    "webdev"
  ],
  "author": "webkid.io",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/wbkd/webpack-starter/issues"
  },
  "eslintConfig": {
    "env": {
      "browser": true,
      "node": true
    },
    "parserOptions": {
      "ecmaVersion": 6,
      "sourceType": "module"
    },
    "rules": {
      "semi": 2
    }
  },
  "homepage": "https://github.com/wbkd/webpack-starter#readme",
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/plugin-transform-class-properties": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "babel-loader": "^8.4.1",
    "clean-webpack-plugin": "^0.1.19",
    "copy-webpack-plugin": "^4.5.2",
    "css-loader": "^1.0.0",
    "eslint": "^5.4.0",
    "eslint-loader": "^2.1.0",
    "file-loader": "^2.0.0",
    "html-webpack-plugin": "^3.2.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "mini-css-extract-plugin": "^0.4.2",
    "prettier": "^3.8.3",
    "pug-html-loader": "^1.1.5",
    "sass": "^1.55.0",
    "sass-loader": "^7.1.0",
    "style-loader": "^0.22.1",
    "webpack": "^4.17.1",
    "webpack-cli": "^3.1.0",
    "webpack-dev-server": "^3.1.5",
    "webpack-merge": "^4.1.4"
  },
  "dependencies": {
    "@babel/polyfill": "^7.12.1",
    "bootstrap": "^5.3.8",
    "d3v4": "^4.2.2",
    "datatables.net": "^1.11.5",
    "html-loader": "^0.5.5",
    "jquery": "^3.3.1",
    "pug-html-loader": "^1.1.5",
    "tabulator-tables": "^5.4.1",
    "tom-select": "^2.6.1",
    "xss": "^1.0.3"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,css,md}": [
      "prettier --write --ignore-unknown",
      "git add"
    ]
  }
}
